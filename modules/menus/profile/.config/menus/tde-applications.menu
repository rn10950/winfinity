   <NotDeleted/>
  </Menu>
  <Include>
   <Filename>Personal Files (Home).desktop</Filename>
  </Include>
 </Menu>
 <Menu>
 <!-- HACK: there is a special unicode "n" character in the word "settings" below
	This is to prevent the custom settings menu from getting confused with the
	system settings menu. (U+0578) -->
  <Name>Settiոgs</Name>
  <Layout>
   <Merge type="files" />
   <Filename>Control Panel.desktop</Filename>
   <Separator/>
   <Filename>Winfinity Control Panel.desktop</Filename>
   <Filename>Network Connections.desktop</Filename>
   <Filename>Printers.desktop</Filename>
   <Filename>Taskbar and Start Menu.desktop</Filename>
  </Layout>
  <Directory>Settiոgs.directory</Directory>
  <NotDeleted/>
  <Include>
   <Filename>Control Panel.desktop</Filename>
   <Filename>Winfinity Control Panel.desktop</Filename>
   <Filename>Network Connections.desktop</Filename>
   <Filename>Printers.desktop</Filename>
   <Filename>Taskbar and Start Menu.desktop</Filename>
  </Include>
 </Menu>
 <Menu>
  <Name>Search</Name>
  <Layout>
   <Merge type="files" />
   <Filename>Find.desktop</Filename>
  </Layout>
  <Directory>Search.directory</Directory>
  <NotDeleted/>
  <Include>
   <Filename>Find.desktop</Filename>
  </Include>
 </Menu>
