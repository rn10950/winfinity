[General]
ConfigVersion=2.3
ConsoleTTYs=tty1,tty2,tty3,tty4,tty5,tty6
PidFile=/var/run/tdm.pid
ReserveServers=:1,:2,:3
ServerVTs=-7
StaticServers=:0

[Shutdown]
BootManager=Grub
HaltCmd=/sbin/poweroff
RebootCmd=/sbin/reboot

[X-*-Core]
AllowNullPasswd=false
AllowRootLogin=false
AllowShutdown=Root
AutoReLogin=false
ClientLogFile=.xsession-errors-%s
CursorTheme=wincursors-classic
Reset=/etc/trinity/tdm/Xreset
Session=/etc/trinity/tdm/Xsession
SessionsDirs=/usr/share/xsessions,/var/lib/menu-xdg/xsessions,/opt/trinity/share/apps/tdm/sessions
Setup=/etc/trinity/tdm/Xsetup
Startup=/etc/trinity/tdm/Xstartup

[X-*-Greeter]
AntiAliasing=false
ColorScheme=Windows95
Compositor=
EchoMode=OneStar
FaceSource=AdminOnly
FailFont=WinfinityTitle,10,-1,5,50,0,0,0,0,0
GUIStyle=Windows
CursorTheme=wincursors-classic
GreetFont=Microsoft Sans Serif,22,-1,5,50,0,0,0,0,0
GreetString=Welcome to %n
GreeterPos=50,50
HiddenUsers=
Language=en_US
LogoArea=Clock
LogoPixmap=/opt/trinity/share/apps/tdm/pics/tdelogo.png
MaxShowUID=29999
MinShowUID=1000
Preloader=/opt/trinity/bin/preloadkde
SelectedUsers=
ShowUsers=NotHidden
SortUsers=true
StdFont=Microsoft Sans Serif,10,-1,5,50,0,0,0,0,0
Theme=
UseBackground=true
UserCompletion=false
UserList=true

[X-:*-Core]
AllowNullPasswd=true
AllowShutdown=All
NoPassEnable=false
NoPassUsers=
ServerArgsLocal=-deferglyphs 16 -nolisten tcp
ServerCmd=/usr/bin/X -br
TerminateServer=true

[X-:*-Greeter]
AllowClose=true
DefaultUser=tdetest
FocusPasswd=true
LoginMode=DefaultLocal
PreselectUser=Previous
SyncKbdLED=true
UseSAK=false

[X-:0-Core]
AutoLoginAgain=false
AutoLoginDelay=0
AutoLoginEnable=false
AutoLoginLocked=false
AutoLoginUser=tdetest
ClientLogFile=.xsession-errors

[X-:0-Greeter]
CursorTheme=wincursors-classic

[Xdmcp]
Enable=false
Willing=/etc/trinity/tdm/Xwilling
